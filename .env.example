PORT=3001                                   # HTTP + WebSocket port
NODE_ENV=development                        # development | production
PUBLIC_ORIGIN=http://localhost:5173         # allowed CORS/socket origin in dev; ignored when NODE_ENV=production (same-origin)
REDIS_URL=                                  # REQUIRED on Vercel: Upstash Redis connection URL (rediss://...)
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302   # comma-separated
TURN_URL=                                   # OPTIONAL: e.g. turn:turn.example.com:3478 (leave empty to disable)
TURN_USERNAME=                              # OPTIONAL: TURN username
TURN_CREDENTIAL=                            # OPTIONAL: TURN password
CLOUDFLARE_TURN_KEY_ID=                     # OPTIONAL: Cloudflare Realtime TURN key ID (server only)
CLOUDFLARE_TURN_KEY_SECRET=                  # OPTIONAL: matching TURN key secret (server only; never expose to client)
MAX_ROOM_SIZE=8                             # max people per room including host (hard cap 8 = number of seats)
ROOM_EMPTY_TTL_MS=60000                     # delete a room this long after the last person leaves
VIDEO_MAX_BITRATE=4000000                   # bits/sec cap per viewer connection, applied by the host
LOG_LEVEL=info                              # pino level
