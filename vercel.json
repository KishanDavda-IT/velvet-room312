{
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 300
    },
    "api/rooms/[roomId].js": {
      "maxDuration": 300
    },
    "api/socket.io.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/r/:roomId",
      "destination": "/index.html"
    }
  ]
}